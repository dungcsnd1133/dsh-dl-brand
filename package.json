{
  "name": "dsh-dl-brand",
  "version": "0.1.0",
  "private": true,
  "description": "DL brand identity and Vietnamese/English personalization for the DSH Web UI: sidebar mark and wordmark, a selectable Vietnamese locale, and the dictionaries behind it.",
  "type": "module",
  "license": "MIT",
  "files": [
    "cordis.patch.yml",
    "lib"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/<user>/dsh-dl-brand.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "i18n",
    "vietnamese",
    "branding"
  ],
  "author": "DL"
}
